Supercentenerians <- NormalizeData(Supercentenerians, normalization.method = "LogNormalize", scale.factor = 10000)
Supercentenerians <- FindVariableFeatures(Supercentenerians, selection.method = "mean.var.plot", dispersion.cutoff = c(0.9, Inf), mean.cutoff = c(0.0125, 2), mean.function = ExpMean, dispersion.function = LogVMR)
top10 <- head(VariableFeatures(Supercentenerians), 10)
plot1 <- VariableFeaturePlot(Supercentenerians)
LabelPoints(plot = plot1, points = top10, repel = TRUE)
Supercentenerians <- ScaleData(Supercentenerians)
all.genes <- rownames(Supercentenerians)
Supercentenerians <- ScaleData(Supercentenerians, features = all.genes)
Supercentenerians <- RunPCA(Supercentenerians, features = VariableFeatures(object = Supercentenerians))
DimPlot(Supercentenerians, reduction = "pca")
